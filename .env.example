# Payments remain unavailable until the merchant selects a provider.
# Optional prepared adapter: Stripe. Confirm merchant-country eligibility first.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public canonical site origin. Live keys require HTTPS; test keys support localhost HTTP.
APP_URL=http://localhost:3000

# Illustrative policy: verify delivery charges, duties and tax treatment before launch.
SHIPPING_FEE_AZN=35
FREE_SHIPPING_THRESHOLD_AZN=1500

# Optional. Use a persistent volume in production, accessible only to the server.
# Defaults to .data/orders.sqlite in the project directory.
ORDERS_DB_PATH=

# Newsletter signups and contact messages are stored locally, not emailed.
# Defaults to .data/engagement.sqlite; use a persistent private volume in production.
ENGAGEMENT_DB_PATH=

# Optional cloud preview proxy hostname(s), comma-separated, without scheme or port.
# Only set this to the actual hostname supplied by your platform's port forwarding.
PREVIEW_HOSTNAMES=
